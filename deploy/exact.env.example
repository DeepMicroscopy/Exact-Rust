# Configuration of exact-server (and of the worker). Copy to exact.env, fill in, keep it private (it holds passwords).
# The names are those of the Django deployment; everything not listed has a default (see crates/exact-core/src/config.rs).

# --- database (a COPY of the production database for the beta, never the live one)
# With deploy/docker-compose.yml the database is the `db` container: it is created with these name/user/password and SQL_HOST/SQL_PORT are
# overridden (db:5432). SQL_HOST is for the native install or an existing PostgreSQL.
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DATABASE=exact_beta
SQL_USER=exact
SQL_PASSWORD=change-me

# --- files: the server WRITES to them (uploads, moving and deleting images, repairs): use copies for the beta
IMAGE_PATH=/srv/exact-beta/images          # the image set folders (exact_<team>_<set>/...)
MEDIA_ROOT=/srv/exact-beta/media           # aux files, plugin icons, registration files, exports
EXACT_CACHE_DIR=/srv/exact-beta/cache      # thumbnails (can be deleted any time)
EXACT_NIFTI_CACHE=/srv/exact-beta/cache/nifti   # inflated .nii.gz volumes (grows; can be deleted any time)

# --- network and login
EXACT_LISTEN=127.0.0.1:8002                # behind a reverse proxy that terminates https (deploy/Caddyfile.example)
EXACT_COOKIE_SECURE=1                      # https only
FIDO_SERVER_ID=exact.hs-flensburg.de       # must be the host name the users open, or a parent domain of it; passkeys are bound to it
FIDO_SERVER_NAME=EXACT
TIME_ZONE=Europe/Berlin
# SESSION_COOKIE_AGE=1209600

# --- readers (the Python with slideio / qt-wsi-registration and an EXACT checkout: the container has them, natively set these)
# SLIDEIO_PYTHON=/opt/exact-venv/bin/python
# SLIDEIO_HELPER=/opt/exact-rust/helpers/slideio_helper.py
# REGISTRATION_PYTHON=/opt/exact-venv/bin/python
# REGISTRATION_HELPER=/opt/exact-rust/helpers/registration_helper.py
# REGISTRATION_EXACT_DIR=/opt/exact/exact
# OPENSLIDE_LIB=/usr/lib/x86_64-linux-gnu/libopenslide.so.0
# EXACT_STATIC_DIR=/opt/exact-rust/frontend/dist

# --- registration worker (only read by the worker unit / compose service)
WORKER_USER=registration-worker            # an account with the model permissions images.change_imageregistration and processing.change_pluginjob
WORKER_PASSWORD=change-me
