# Settings of a new installation with deploy/quickstart.yml. Copy to deploy/.env and set the two passwords; keep the file private.

# The database password: any long random string (the database is not reachable from outside Docker).
SQL_PASSWORD=change-me

# The first account, created on the first start; nothing happens once a superuser exists. Change the password in the web
# interface afterwards; you can then delete EXACT_ADMIN_PASSWORD from this file.
EXACT_ADMIN_USER=admin
EXACT_ADMIN_PASSWORD=change-me
# A first team, with the admin as its admin (delete the line for none).
EXACT_ADMIN_TEAM=My team
# EXACT_ADMIN_EMAIL=admin@example.org

TIME_ZONE=Europe/Berlin

# --- optional
# The port in the browser (http://localhost:8002).
# EXACT_PORT=8002
# Reachable from other machines too (default: this machine only). Then put https in front (deploy/Caddyfile.example) and set
# EXACT_COOKIE_SECURE=1 and FIDO_SERVER_ID=<the host name>.
# EXACT_BIND=0.0.0.0
# Slides in a folder of your own instead of the Docker volume `exact-rust_images` (to copy slides in directly, or to back them up).
# The folder must exist; Windows/macOS: any folder of yours, with forward slashes (C:/exact-data/images); Linux: owned by uid 1000,
# or set CONTAINER_USER to your uid:gid (`id -u`:`id -g`). The same works for MEDIA_ROOT (exports, aux files) and EXACT_CACHE_DIR.
# IMAGE_PATH=C:/exact-data/images
# CONTAINER_USER=1000:1000
# Include the DeeperHistReg registration plugin (PyTorch) in the image; rebuild with `up -d --build`.
# WITH_DEEPERHISTREG=1

# --- registration worker (optional): create the account in the web interface (Administration → Users → New worker account…),
# paste its two lines here and start it: docker compose -f deploy/quickstart.yml --profile worker up -d
# WORKER_USER=
# WORKER_PASSWORD=
